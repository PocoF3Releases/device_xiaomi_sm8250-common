    <string name="touch_controls_mode_group">"Glavna postavka"</string>
    <string name="touch_controls_mode_help">"Unapred podešena vrednost zamenjuje odziv, osetljivost, nišan i stabilnost dodira zajedno. Ručna podešavanja ostaju sačuvana za kasnije. Zaštita ivica radi odvojeno u oba režima."</string>
