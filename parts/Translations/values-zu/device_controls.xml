    <string name="touch_controls_mode_group">"Isethingi eyinhloko"</string>
    <string name="touch_controls_mode_help">"Isethingi esethiwe ishintsha ukusabela, ukuzwela, ukukhomba nokuzinza kokuthepha ndawonye. Amasethingi enziwa ngesandla agcinelwa kamuva. Ukuvikelwa kwamaphethelo kusebenza ngokuhlukile kuzo zombili izindlela."</string>
